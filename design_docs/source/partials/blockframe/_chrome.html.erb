<%#
  ExUI Manage Cases chrome above the tab strip.
  Locals:
    show_case_header — case number + Next step / Go (default true)
    minimal — only Manage cases + case number have text; other chrome is empty bars
    nav — :local_authority omits Create case
    highlight_nav — :upload_batch shows Upload batch file with a yellow outline
    highlight_next_step — yellow outline on the Next step dropdown
    next_step_event — event name shown in the Next step dropdown
    success_banner — when set, hmcts-banner--success sits below the ExUI bar
%>
<% show_case_header = (defined?(show_case_header) && !show_case_header.nil?) ? show_case_header : true %>
<% minimal = (defined?(minimal) && minimal) ? minimal : false %>
<% nav = (defined?(nav) && nav) ? nav.to_sym : nil %>
<% highlight_nav = (defined?(highlight_nav) && highlight_nav) ? highlight_nav.to_sym : nil %>
<% highlight_next_step = (defined?(highlight_next_step) && highlight_next_step) ? highlight_next_step : false %>
<% show_create = nav != :local_authority %>
<% show_upload_label = !minimal || highlight_nav == :upload_batch %>
<% upload_class = highlight_nav == :upload_batch ? " bf-exui__nav-link--highlight" : "" %>
<% next_step_event = (defined?(next_step_event) && next_step_event) ? next_step_event : nil %>
<% next_step_class = highlight_next_step ? " bf-exui__next-step-select--highlight" : "" %>
<% next_step_class += " bf-exui__next-step-select--labelled" if next_step_event %>
<% next_step_title = next_step_event ? "Next step: #{next_step_event}" : "Next step dropdown" %>
<% success_banner = (defined?(success_banner) && success_banner) ? success_banner : nil %>
<div class="bf-exui"><div class="bf-exui__bar"><div class="bf-exui__bar-row"><span class="bf-exui__brand" title="Manage cases">Manage cases</span><span class="bf-exui__sign-out" title="Sign out"><%= "Sign out" unless minimal %></span></div><div class="bf-exui__bar-row bf-exui__bar-row--nav"><div class="bf-exui__nav"><% if show_create %><span class="bf-exui__nav-link" title="Create case"><%= "Create case" unless minimal %></span><% end %><span class="bf-exui__nav-link<%= upload_class %>" title="Upload batch file"><%= "Upload batch file" if show_upload_label %></span></div><div class="bf-exui__search"><span class="bf-exui__search-input" title="Case reference input"></span><span class="bf-exui__search-btn" title="Find"></span></div></div></div><% if success_banner %><div class="hmcts-banner hmcts-banner--success" role="region" aria-label="Success" title="hmcts-banner--success"><span class="hmcts-banner__icon" aria-hidden="true" title="Success icon"></span><div class="hmcts-banner__message"><span class="hmcts-banner__heading" title="<%= escape_html(success_banner) %>"><%= escape_html(success_banner) %></span></div></div><% end %><% if show_case_header %><div class="bf-exui__case"><span class="bf-exui__case-number" title="Case number">Case number: 1788-2660-5799-1856</span><div class="bf-exui__next-step"><span class="bf-exui__next-step-select<%= next_step_class %>" title="<%= escape_html(next_step_title) %>"><%= escape_html(next_step_event) if next_step_event %></span><span class="bf-exui__go" title="Go"></span></div></div><% end %></div>
