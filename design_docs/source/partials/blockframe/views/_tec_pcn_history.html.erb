<%#
  TEC PCN — History tab (CCD case history).
  Locals: caption, highlight_tab
%>
<% caption = (defined?(caption) && caption) ? caption : "TEC PCN — History" %>
<% highlight_tab = (defined?(highlight_tab) && highlight_tab) ? highlight_tab : nil %>
<% body = [
  partial("partials/blockframe/text", locals: { size: :title, label: "History" }),
  '<div class="bf-table" title="Case history table">',
  '<div class="bf-table__head" title="Table header"><span class="bf-table__cell bf-table__cell--head bf-table__cell--wide" title="Event (column)">Event</span><span class="bf-table__cell bf-table__cell--head" title="Date (column)">Date</span><span class="bf-table__cell bf-table__cell--head" title="Author (column)">Author</span></div>',
  '<div class="bf-table__row" title="History row"><span class="bf-table__cell bf-table__cell--wide"><span class="bf-table__value bf-table__value--callout" title="Event">Validate OOT application</span></span><span class="bf-table__cell"><span class="bf-table__bar" style="width: 78%" title="Date value"></span></span><span class="bf-table__cell"><span class="bf-table__bar" style="width: 65%" title="Author value"></span></span></div>',
  '<div class="bf-table__row" title="History row"><span class="bf-table__cell bf-table__cell--wide"><span class="bf-table__value" title="Event">Edit TE9 application</span></span><span class="bf-table__cell"><span class="bf-table__bar" style="width: 70%" title="Date value"></span></span><span class="bf-table__cell"><span class="bf-table__bar" style="width: 58%" title="Author value"></span></span></div>',
  '<div class="bf-table__row" title="History row"><span class="bf-table__cell bf-table__cell--wide"><span class="bf-table__bar" style="width: 72%" title="Event value"></span></span><span class="bf-table__cell"><span class="bf-table__bar" style="width: 82%" title="Date value"></span></span><span class="bf-table__cell"><span class="bf-table__bar" style="width: 50%" title="Author value"></span></span></div>',
  '<div class="bf-table__row" title="History row"><span class="bf-table__cell bf-table__cell--wide"><span class="bf-table__bar" style="width: 60%" title="Event value"></span></span><span class="bf-table__cell"><span class="bf-table__bar" style="width: 68%" title="Date value"></span></span><span class="bf-table__cell"><span class="bf-table__bar" style="width: 72%" title="Author value"></span></span></div>',
  '</div>'
].join %>
<%= partial "partials/blockframe/page", locals: { caption: caption, active: :history, body: body, highlight_tab: highlight_tab } %>
