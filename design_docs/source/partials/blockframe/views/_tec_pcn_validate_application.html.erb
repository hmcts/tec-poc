<%#
  TEC PCN — Validate OOT application event (journey wireframe).
  Uses ExUI form field primitives: FixedRadioList for Form valid / Form invalid,
  TextArea for the rejection email when invalid.
  Locals:
    caption — frame label
    result  — :valid (default) | :invalid
%>
<% caption = (defined?(caption) && caption) ? caption : "Event — Validate OOT application" %>
<% result = (defined?(result) && result) ? result.to_sym : :valid %>
<% invalid = result == :invalid %>
<% selected = invalid ? 1 : 0 %>
<% body_parts = [
  '<div class="bf-form">',
  partial("partials/blockframe/text", locals: { size: :title, label: "Validate OOT application" }),
  partial("partials/blockframe/text", locals: {
    size: :medium,
    label: invalid ?
      "Confirm the form is invalid and edit the rejection email." :
      "Confirm the form validation result. Form valid revalidates against business rules."
  }),
  partial("partials/blockframe/field", locals: {
    type: :fixed_radio_list,
    label: "Form validation result",
    options: ["Form valid", "Form invalid"],
    selected: selected,
    callout: true
  })
] %>
<% if invalid %>
<% body_parts << partial("partials/blockframe/field", locals: {
  type: :textarea,
  label: "Rejection email",
  title: "Rejection email — textarea"
}) %>
<% end %>
<% body_parts.concat([
  '<div class="bf-actions"><span class="bf-action bf-action--secondary" title="Previous"></span><span class="bf-action bf-action--primary" title="Continue"></span></div>',
  '</div>'
]) %>
<% body = body_parts.join %>
<%= partial "partials/blockframe/page", locals: { caption: caption, show_tabs: false, body: body } %>
