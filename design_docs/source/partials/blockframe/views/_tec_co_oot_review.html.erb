<%#
  Case officer review of an out-of-time refusal.
  Locals:
    caption
%>
<% page_title = "Review OOT refusal decision" %>
<% body_text = "The LA has decided to refuse this application. Should their decision be upheld or overturned? Overturning their refusal decision will immediately revoke the case." %>
<% caption = (defined?(caption) && caption) ? caption : "Event — #{page_title}" %>
<% body = [
  '<div class="bf-form bf-form--full">',
  partial("partials/blockframe/text", locals: { size: :title, label: page_title, callout: true }),
  partial("partials/blockframe/text", locals: { size: :medium, label: body_text }),
  partial("partials/blockframe/field", locals: {
    type: :fixed_radio_list,
    label: "Decision",
    title: "Decision — FixedRadioList",
    options: ["Uphold decision", "Overturn decision"],
    selected: -1,
    callout: true
  }),
  '<div class="bf-actions"><span class="bf-action bf-action--secondary" title="Previous"></span><span class="bf-action bf-action--primary" title="Submit">Submit</span></div>',
  "</div>"
].map { |part| part.to_s.strip }.reject(&:empty?).join.gsub(/\n[ \t]*\n/, "\n") %>
<%= partial "partials/blockframe/page", locals: { caption: caption, show_tabs: false, body: body } %>
