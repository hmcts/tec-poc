<%#
  TEC PCN — Tasks tab.
  Locals: caption, highlight, callout, highlight_tab, highlight_step (:validate | :edit | :all)
%>
<% caption = (defined?(caption) && caption) ? caption : "TEC PCN — Tasks" %>
<% highlight = (defined?(highlight) && highlight) ? highlight : false %>
<% callout = (defined?(callout) && callout) ? callout : false %>
<% highlight_tab = (defined?(highlight_tab) && highlight_tab) ? highlight_tab : nil %>
<% highlight_step = (defined?(highlight_step) && highlight_step) ? highlight_step : nil %>
<% body = [
  partial("partials/blockframe/text", locals: { size: :title, label: "Active tasks" }),
  partial("partials/blockframe/task_card", locals: {
    task_title: "Validate OOT application",
    priority: "High",
    due_date: "13 September 2026",
    assignee: "tec-demo@test.com",
    next_steps: true,
    highlight: highlight,
    callout: callout,
    highlight_step: highlight_step,
    extra_next_steps: true,
    next_step_label: "Validate OOT application",
    next_step_label_2: "Edit application"
  }),
  partial("partials/blockframe/task_card", locals: {
    task_title: "Review issued case",
    priority: "Urgent",
    due_date: "12 September 2026",
    assignee: "Unassigned",
    manage_only: true
  }),
  partial("partials/blockframe/task_card", locals: {
    task_title: "Check respondent details",
    priority: "Low",
    due_date: "18 September 2026",
    assignee: "Alex Clerk",
    next_steps: false
  })
].join %>
<%= partial "partials/blockframe/page", locals: { caption: caption, active: :tasks, body: body, highlight_tab: highlight_tab } %>
