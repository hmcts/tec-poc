<%#
  TEC PCN — Case details tab (Registration / Application / Time extension).
  Field keys show labels; values are empty bars of varying width.
  Locals:
    caption
    validation_errors — when true, show out-of-time TE9/TE7 pair with Form invalid callouts
    highlight_tab
    highlight_next_step — yellow outline on the Next step dropdown
    next_step_event — event name shown in the Next step dropdown
    show_general_applications — when true, show the General applications section
    nav — passed to chrome (e.g. :local_authority)
    success_banner — success message shown below the ExUI bar
    show_oot_refusal_decision — when true, show Out of time application decision under Registration
%>
<% caption = (defined?(caption) && caption) ? caption : "TEC PCN — Case details" %>
<% validation_errors = (defined?(validation_errors) && validation_errors) ? validation_errors : false %>
<% highlight_tab = (defined?(highlight_tab) && highlight_tab) ? highlight_tab : nil %>
<% highlight_next_step = (defined?(highlight_next_step) && highlight_next_step) ? highlight_next_step : false %>
<% next_step_event = (defined?(next_step_event) && next_step_event) ? next_step_event : nil %>
<% show_general_applications = (defined?(show_general_applications) && show_general_applications) ? show_general_applications : false %>
<% nav = (defined?(nav) && nav) ? nav : nil %>
<% success_banner = (defined?(success_banner) && success_banner) ? success_banner : nil %>
<% show_oot_refusal_decision = (defined?(show_oot_refusal_decision) && show_oot_refusal_decision) ? show_oot_refusal_decision : false %>
<% application_title = validation_errors ? "Witness statement — Out of time (TE9)" : "Witness statement — In time" %>
<% time_extension_title = validation_errors ? "Application to file out of time (TE7)" : "Application to file out of time" %>
<% validation_value = validation_errors ?
  '<span class="bf-kv__value bf-callout" title="Form validation result value">Form invalid</span>' :
  '<span class="bf-kv__value" style="width: 34%"></span>' %>
<% time_validation_value = validation_errors ?
  '<span class="bf-kv__value bf-callout" title="Form validation result value">Form invalid</span>' :
  '<span class="bf-kv__value" style="width: 38%"></span>' %>
<% body = [
  '<div class="bf-kv" title="State"><span class="bf-kv__key">State</span><span class="bf-kv__value" style="width: 44%"></span></div>',
  '<div class="bf-section" title="Registration section">',
  partial("partials/blockframe/text", locals: { size: :title, label: "Registration" }),
  '<div class="bf-kv" title="File identifier"><span class="bf-kv__key">File identifier</span><span class="bf-kv__value" style="width: 48%"></span></div>',
  '<div class="bf-kv" title="Batch identifier"><span class="bf-kv__key">Batch identifier</span><span class="bf-kv__value" style="width: 36%"></span></div>',
  '<div class="bf-kv" title="Batch case"><span class="bf-kv__key">Batch case</span><span class="bf-kv__value" style="width: 42%"></span></div>',
  '<div class="bf-kv" title="Penalty charge number"><span class="bf-kv__key">Penalty charge number</span><span class="bf-kv__value" style="width: 28%"></span></div>',
  '<div class="bf-kv" title="Local authority"><span class="bf-kv__key">Local authority</span><span class="bf-kv__value" style="width: 58%"></span></div>',
  '<div class="bf-kv" title="Respondent details"><span class="bf-kv__key">Respondent details</span><span class="bf-kv__value" style="width: 72%"></span></div>',
  '<div class="bf-kv" title="Vehicle registration"><span class="bf-kv__key">Vehicle registration</span><span class="bf-kv__value" style="width: 22%"></span></div>',
  '<div class="bf-kv" title="Payment status"><span class="bf-kv__key">Payment status</span><span class="bf-kv__value" style="width: 30%"></span></div>',
  '<div class="bf-kv" title="Registration document"><span class="bf-kv__key">Registration document</span><span class="bf-kv__value" style="width: 52%"></span></div>',
  "</div>",
  (show_oot_refusal_decision ? [
    '<div class="bf-section" title="Out of time application decision section">',
    partial("partials/blockframe/text", locals: { size: :title, label: "Out of time application decision", callout: true }),
    '<div class="bf-kv" title="Decision"><span class="bf-kv__key bf-callout">Decision</span><span class="bf-kv__value bf-callout" title="Decision value">Refused</span></div>',
    "</div>"
  ].join : ""),
  '<div class="bf-section" title="Application section">',
  partial("partials/blockframe/text", locals: { size: :title, label: application_title, callout: validation_errors }),
  %(<div class="bf-kv" title="Form validation result"><span class="bf-kv__key#{validation_errors ? ' bf-callout' : ''}">Form validation result</span>#{validation_value}</div>),
  '<div class="bf-kv" title="Date received"><span class="bf-kv__key">Date received</span><span class="bf-kv__value" style="width: 40%"></span></div>',
  '<div class="bf-kv" title="Application type"><span class="bf-kv__key">Application type</span><span class="bf-kv__value" style="width: 26%"></span></div>',
  '<div class="bf-kv" title="Applicant"><span class="bf-kv__key">Applicant</span><span class="bf-kv__value" style="width: 55%"></span></div>',
  '<div class="bf-kv" title="Address"><span class="bf-kv__key">Address</span><span class="bf-kv__value" style="width: 68%"></span></div>',
  '<div class="bf-kv" title="Declaration"><span class="bf-kv__key">Declaration</span><span class="bf-kv__value" style="width: 44%"></span></div>',
  '<div class="bf-kv" title="PCN"><span class="bf-kv__key">PCN</span><span class="bf-kv__value" style="width: 32%"></span></div>',
  '<div class="bf-kv" title="VRN"><span class="bf-kv__key">VRN</span><span class="bf-kv__value" style="width: 24%"></span></div>',
  "</div>",
  '<div class="bf-section" title="Time extension section">',
  partial("partials/blockframe/text", locals: { size: :title, label: time_extension_title, callout: validation_errors }),
  %(<div class="bf-kv" title="Form validation result"><span class="bf-kv__key#{validation_errors ? ' bf-callout' : ''}">Form validation result</span>#{time_validation_value}</div>),
  '<div class="bf-kv" title="Permission sought"><span class="bf-kv__key">Permission sought</span><span class="bf-kv__value" style="width: 50%"></span></div>',
  '<div class="bf-kv" title="Reasons"><span class="bf-kv__key">Reasons</span><span class="bf-kv__value" style="width: 76%"></span></div>',
  '<div class="bf-kv" title="Signed and dated"><span class="bf-kv__key">Signed and dated</span><span class="bf-kv__value" style="width: 42%"></span></div>',
  "</div>",
  (show_general_applications ? [
    '<div class="bf-section" title="General applications section">',
    partial("partials/blockframe/text", locals: { size: :title, label: "General applications", callout: true }),
    '<div class="bf-kv" title="Rank"><span class="bf-kv__key bf-callout">Rank</span><span class="bf-kv__value bf-callout" title="Rank value">1</span></div>',
    '<div class="bf-kv" title="Applicant"><span class="bf-kv__key">Applicant</span><span class="bf-kv__value bf-callout" title="Applicant value">Respondent</span></div>',
    '<div class="bf-kv" title="Type"><span class="bf-kv__key">Type</span><span class="bf-kv__value bf-callout" title="Type value">Adjourn</span></div>',
    '<div class="bf-kv" title="State"><span class="bf-kv__key bf-callout">State</span><span class="bf-kv__value bf-callout" title="Application state">Issued</span></div>',
    "</div>"
  ].join : "")
].join %>
<%= partial "partials/blockframe/page", locals: { caption: caption, active: :case_details, body: body, highlight_tab: highlight_tab, highlight_next_step: highlight_next_step, next_step_event: next_step_event, nav: nav, success_banner: success_banner } %>
